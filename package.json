{
  "name": "idlehub",
  "productName": "IdleHub",
  "version": "0.1.0",
  "private": true,
  "description": "Várias contas de jogos idle de navegador numa janela só, cada uma com sessão isolada. Projeto de estudo.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "theme": "node scripts/build-theme.mjs",
    "screens": "node scripts/capture-screens.js",
    "icon": "electron scripts/build-icon.js",
    "atalho": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/criar-atalho.ps1",
    "dist": "electron-builder --win nsis --publish never",
    "dist:store": "electron-builder --win appx --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@material/material-color-utilities": "0.3.0",
    "electron": "43.8.12",
    "electron-builder": "26.18.0"
  },
  "author": "Iury França",
  "homepage": "https://github.com/iuryfranca/idlehub",
  "repository": {
    "type": "git",
    "url": "https://github.com/iuryfranca/idlehub.git"
  },
  "build": {
    "appId": "io.github.iuryfranca.idlehub",
    "productName": "IdleHub",
    "copyright": "© 2026 Iury França · MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "LICENSE",
      "NOTICE.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IdleHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE",
      "artifactName": "IdleHub-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "appx": {
      "identityName": "00000IuryFranca.IdleHub",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Iury França",
      "applicationId": "IdleHub",
      "displayName": "IdleHub",
      "backgroundColor": "transparent",
      "showNameOnTiles": false,
      "languages": [
        "pt-BR",
        "en-US",
        "es-ES"
      ],
      "artifactName": "IdleHub-${version}-store.appx",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  }
}
